# Kopier denne filen til ".env" og fyll inn egne verdier.
# ".env" skal ALDRI committes til git (den ligger allerede i .gitignore).

SECRET_KEY=bytt-meg-til-en-lang-tilfeldig-hemmelig-streng
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# DATABASE_URL=postgres://bruker:passord@host:5432/dbnavn

# E-post (la stå tom for å bruke konsoll-utskrift i utvikling)
# For ekte utsendelse via Gmail/Google Workspace, se README-seksjonen "E-post" -
# EMAIL_HOST_PASSWORD skal være et app-passord, ikke det vanlige Google-passordet.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Florø Detailing <din-konto@gmail.com>
BUSINESS_NOTIFICATION_EMAIL=
